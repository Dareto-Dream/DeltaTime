<!DOCTYPE html>
<html lang="en" class="<%= Rails.env == 'production' ? 'production' : 'development' %>" data-theme="<%= current_theme %>" data-color-scheme="<%= current_theme_color_scheme %>">
  <head>
    <title><%= @page_title || content_for(:title) || 'Deltatime - Track your time' %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="<%= current_theme_color_scheme %>">

    <meta name="description" content="<%= @meta_description || content_for(:meta_description) || 'Free and open-source time tracker. Track your time across 75+ editors, Minecraft, and more.' %>">
    <meta name="keywords" content="<%= @meta_keywords || content_for(:meta_keywords) || 'time tracker, productivity stats, wakatime alternative, free time tracking, activity statistics, developer analytics, work time, productivity tracking' %>">
    <meta name="author" content="Deltatime">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="<%= content_for(:canonical_url) || request.original_url %>">
    <meta name="theme-color" content="<%= current_theme_color %>">
    <meta name="msapplication-TileColor" content="<%= current_theme_color %>">
    <meta property="og:title" content="<%= @og_title || content_for(:og_title) || @page_title || content_for(:title) || 'Deltatime - Free Time Tracker' %>">
    <meta property="og:description" content="<%= @og_description || content_for(:og_description) || @meta_description || content_for(:meta_description) || 'Free and open-source time tracker. Track your time across 75+ editors, Minecraft, and more.' %>">
    <meta property="og:url" content="<%= content_for(:og_url) || request.original_url %>">
    <meta property="og:type" content="<%= content_for(:og_type) || 'website' %>">
    <meta property="og:image" content="<%= @og_image || content_for(:og_image) || safe_asset_path('og.jpg', fallback: 'favicon.png') %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Deltatime">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= @twitter_title || content_for(:twitter_title) || @page_title || content_for(:title) || 'Deltatime - Free Time Tracker' %>">
    <meta name="twitter:description" content="<%= @twitter_description || content_for(:twitter_description) || @meta_description || content_for(:meta_description) || 'Free and open-source time tracker. Track your time across 75+ editors, Minecraft, and more.' %>">
    <meta name="twitter:image" content="<%= @twitter_image || content_for(:twitter_image) || safe_asset_path('favicon.png', fallback: 'og.jpg') %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% if current_user %>
      <meta name="user-is-superadmin" content="<%= current_user.admin_level == 'superadmin' %>">
      <meta name="user-is-admin" content="<%= current_user.admin_level == 'admin' %>">
      <meta name="user-is-viewer" content="<%= current_user.admin_level == 'viewer' %>">
      <meta name="user-is-ultraadmin" content="<%= current_user.admin_level == 'ultraadmin' %>">
    <% end %>

    <% include_external_scripts = !Rails.env.test? %>
    <% include_jam_scripts = include_external_scripts && params[:jam].present? %>

    <%= yield :head %>

    <% if include_jam_scripts %>
      <!-- Lets users record their screen from your site -->
      <meta name="jam:team" content="a5978e52-2479-4dd3-9883-593aa7a4f121">
      <script type="module" src="https://js.jam.dev/recorder.js"></script>

      <!-- Captures user events and developer logs -->
      <script type="module" src="https://js.jam.dev/capture.js"></script>
    <% end %>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Deltatime",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "description": "Track your time easily with Deltatime. A free tool to see how much time you spend working across different languages, editors, and more.",
        "url": "https://deltatime.deltavdevs.com",
        "downloadUrl": "https://deltatime.deltavdevs.com",
        "sameAs": ["https://github.com/Dareto-Dream/DeltaTime"],
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "author": {
          "@type": "Organization",
          "name": "Deltatime",
          "url": "https://deltatime.deltavdevs.com"
        },
        "softwareVersion": "2.0",
        "datePublished": "2025-01-01",
        "license": "https://opensource.org/licenses/MIT",
        "programmingLanguage": "Ruby",
        "codeRepository": "https://github.com/Dareto-Dream/DeltaTime",
        "supportingData": "Free time tracker",
        "featureList": ["Track your time across 75+ editors and more", "See which languages you use most", "View daily activity statistics", "Compare with others on leaderboards", "Free and open source"]
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Deltatime",
        "url": "https://deltatime.deltavdevs.com"
      }
    </script>

    <% if request.path == "/" %>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is Deltatime?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Deltatime is a free time tracker that helps you see how much time you spend working on your projects. It tracks your time across different languages, editors, and more."
              }
            },
            {
              "@type": "Question",
              "name": "Is Deltatime free?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes! Deltatime is completely free to use. There are no paid plans or hidden costs."
              }
            },
            {
              "@type": "Question",
              "name": "How is Deltatime different from WakaTime?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Deltatime is free and open source, while WakaTime has paid plans. Deltatime gives you all features for free and you can host it yourself."
              }
            },
            {
              "@type": "Question",
              "name": "Is Deltatime the same as WakaTime?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Deltatime is a separate, independent open-source project. While both track your time, Deltatime is completely free and its community lives on Discord rather than WakaTime's paid platform."
              }
            }
          ]
        }
      </script>
    <% end %>

    <%= favicon_link_tag asset_path('favicon.png'), type: 'image/png' %>
    <link rel="apple-touch-icon" href="<%= asset_path('favicon.png') %>">

    <% if include_external_scripts %>
      <%# DeltaVDevs cookie banner, then analytics (no analytics cookie without consent). Replaces Plausible. %>
      <script defer src="https://analytics.deltavdevs.com/consent.js" data-policy="/privacy"></script>
      <script defer src="https://analytics.deltavdevs.com/t.js"></script>
    <% end %>

    <% if Sentry.get_trace_propagation_meta %>
      <%= sanitize Sentry.get_trace_propagation_meta, tags: %w[meta], attributes: %w[name content] %>
    <% end %>
    <% include_vite_assets = !Rails.env.test? || ENV["INERTIA_SYSTEM_TEST"] == "1" %>
    <% if include_vite_assets %>
      <% defer_vite_stylesheets = inertia_ssr_head&.include?('data-initial-vite-stylesheet="critical"') %>
      <%= inertia_ssr_head %>
      <%= vite_entrypoint_stylesheet_tag "application", media: ("print" if defer_vite_stylesheets), data: ({ deferred_vite_stylesheet: true } if defer_vite_stylesheets) %>
      <%= vite_client_tag %>
      <%= vite_typescript_tag "inertia", skip_style_tags: defer_vite_stylesheets %>
      <% if defer_vite_stylesheets %>
        <%= vite_entrypoint_stylesheet_tag "inertia", type: :typescript, media: "print", data: { deferred_vite_stylesheet: true } %>
        <noscript>
          <%= vite_entrypoint_stylesheet_tag "application" %>
          <%= vite_entrypoint_stylesheet_tag "inertia", type: :typescript %>
        </noscript>
        <%= javascript_tag nonce: true do %>
          document.querySelectorAll("link[data-deferred-vite-stylesheet]").forEach((link) => {
            const activate = () => { link.media = "all"; };
            if (link.sheet) activate();
            else link.addEventListener("load", activate, { once: true });
          });
        <% end %>
      <% end %>
    <% end %>
    <%= inertia_ssr_head unless include_vite_assets %>

    <!--
    TODO: don't hardcode this!
    It's not a secret, but it's a code smell.
    -->
    <meta name="google-site-verification" content="I4TpbUG8M-kpernUDtUBjwm-UqBnha1IqGayR5vs_Fw">
  </head>

  <body class="<%= content_for(:body_class) %> flex min-h-screen bg-darker">
    <%= yield %>
  </body>
</html>
